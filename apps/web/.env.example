# Copy to .env and adjust as needed.

# Absolute URL of the API, including /api/v1. Set for Cloudflare Pages builds;
# leave unset in development to use the Vite proxy at /api.
VITE_API_URL=https://your-api-host.example.edu/api/v1

# Where the dev server proxies /api requests. Defaults to http://localhost:8089.
# API_PROXY_TARGET=http://localhost:8089
