# Copy to .env and adjust as needed.

# Absolute URL of the API, including /api/v1. Leave unset in development to use the
# Vite proxy at /api (forwards to API_PROXY_TARGET, default http://localhost:8089).
VITE_API_URL=https://your-api-host.example.edu/api/v1

# Where the dev server proxies /api requests. Defaults to http://localhost:8089.
# API_PROXY_TARGET=http://localhost:8089
