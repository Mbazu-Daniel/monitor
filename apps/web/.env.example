# Copy to .env and adjust as needed.

# Absolute URL of the API origin. Set for Cloudflare Pages builds;
# leave unset in development to use the Vite proxy at /api.
# A trailing /api/v1 is stripped if present, so both forms work.
VITE_API_URL=https://your-api-host.example.edu

# Where the dev server proxies /api requests. Defaults to http://localhost:8089.
# API_PROXY_TARGET=http://localhost:8089
