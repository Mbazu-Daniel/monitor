NODE_ENV=development
PORT=8089
# Trust X-Forwarded-* headers (req.ip for rate limiting). Enable only behind a proxy
# that sets them (e.g. Railway). Defaults to true in production, false otherwise.
# TRUST_PROXY=true

DATABASE_URL=postgresql://mivacampus:mivacampus@localhost:54443/mivacampus

BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:8089

WEB_URL=http://localhost:5173
# Extra trusted origins (better-auth origin check + CORS), comma-separated.
# Add every origin the browser talks to the API from — e.g. 5174 when the dev
# server falls back to the next port, the vite preview on 4173, and the public
# domain if the API sits behind the same-origin proxy.
# WEB_ORIGIN=http://localhost:5174,http://localhost:4173,https://miva.oktopals.com
# WEB_ORIGIN=https://miva.example.com

# Transactional email (Resend). Leaving RESEND_API_KEY unset skips sending
# EMAIL_FROM=MivaCampus <onboarding@resend.dev>
# RESEND_API_KEY=

# Attachments (Cloudflare R2, S3-compatible). Uploads are disabled until all four are set;
# STORAGE_ENDPOINT defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com when unset.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# STORAGE_ENDPOINT=

# LOG_LEVEL=info

# Swagger docs at /api/v1/docs. Always on outside production; in production
# they are only served when this is set to "true".
# SWAGGER_ENABLED=false


# Soonwhy telemetry (https://soonwhy.com). Required to boot the API — the app
# fails fast with "Soonwhy Node SDK apiKey is required" when unset.
# Get a key from the Soonwhy dashboard; endpoint defaults to the hosted ingest.
# SOONWHY_API_KEY=
# SOONWHY_ENDPOINT=      # only for local/self-hosted ingest
