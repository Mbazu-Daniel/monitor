{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/api/Dockerfile",
    "watchPatterns": [
      "apps/api/**",
      "packages/contracts/**",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "package.json",
      ".dockerignore",
      "railway.json"
    ]
  }
}
