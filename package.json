{
  "name": "mivacampus-monorepo",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:generate": "turbo db:generate",
    "db:push": "turbo db:push",
    "db:seed": "turbo db:seed",
    "smoke": "bash scripts/smoke.sh",
    "test": "turbo test"
  },
  "devDependencies": {
    "turbo": "^2.5.6"
  }
}
