generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ------------------ Enums (string unions for SQLite clarity) ------------------
// Role: STUDENT | STAFF | OFFICER | ADMIN
// Priority: LOW | MEDIUM | HIGH | URGENT
// Status: OPEN | ASSIGNED | IN_PROGRESS | ON_HOLD | RESOLVED | CLOSED | REJECTED

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("STUDENT") // STUDENT | STAFF | OFFICER | ADMIN
  department   String?
  phone        String?
  matricNo     String? // matriculation / staff number
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requests      ServiceRequest[]
  assignments   Assignment[]     @relation("OfficerAssignments")
  assignedBy    Assignment[]     @relation("AssignedBy")
  statusLogs    StatusLog[]
  comments      Comment[]
  notifications Notification[]
  auditLogs     AuditLog[]
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  icon        String   @default("Wrench")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requests ServiceRequest[]
}

model ServiceRequest {
  id          String   @id @default(cuid())
  reference   String   @unique // e.g. SR-2025-0001
  title       String
  description String
  location    String
  priority    String   @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  status      String   @default("OPEN") // OPEN | ASSIGNED | IN_PROGRESS | ON_HOLD | RESOLVED | CLOSED | REJECTED
  categoryId  String
  creatorId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  creator     User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  attachments Attachment[]
  assignments Assignment[]
  statusLogs  StatusLog[]
  comments    Comment[]
}

model Assignment {
  id          String    @id @default(cuid())
  requestId   String
  officerId   String
  assignedById String
  note        String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  releasedAt  DateTime?

  request    ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  officer    User           @relation("OfficerAssignments", fields: [officerId], references: [id], onDelete: Cascade)
  assignedByUser User       @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([officerId])
}

model StatusLog {
  id         String   @id @default(cuid())
  requestId  String
  userId     String
  fromStatus String?
  toStatus   String
  note       String?
  createdAt  DateTime @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model Attachment {
  id        String   @id @default(cuid())
  requestId String
  filename  String
  mimeType  String
  size      Int
  data      String // base64 encoded file content
  createdAt DateTime @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model Comment {
  id        String   @id @default(cuid())
  requestId String
  userId    String
  body      String
  createdAt DateTime @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO") // INFO | SUCCESS | WARNING | ASSIGNMENT | STATUS | COMMENT
  requestId String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String // e.g. USER_LOGIN, REQUEST_CREATED, REQUEST_ASSIGNED...
  entityType String // USER | REQUEST | CATEGORY | AUTH
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}
